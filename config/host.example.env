# Local host settings for NavMin hardware access.
# Copy this file to config/host.local.env and edit values for the current PC.
# Do not add shell quotes around values. Spaces in values are supported.

# Current USB-UART device path used only by the one-time serial setup script.
# The stable runtime path is created from SERIAL_ALIAS.
SERIAL_SETUP_DEVICE=/dev/ttyUSB0
SERIAL_ALIAS=navmin-turret

# Network interface connected to the camera network.
# Examples: enp3s0, eno1, wlp2s0.
CAMERA_INTERFACE=enp3s0

# Static IPv4 address of this PC expected by camera/video senders.
# This is an example only; replace it with the real destination address.
CAMERA_HOST_ADDRESS=192.168.42.2/24

# NetworkManager connection profile managed by the NavMin host scripts.
CAMERA_PROFILE_NAME=NavMin Cameras
