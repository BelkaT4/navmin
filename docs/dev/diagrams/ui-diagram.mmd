flowchart TB
  flag_vision_in["IN: camera-derived<br/>VisionResult / working frames / overlays"]
  flag_session_in["IN: barrier<br/>CameraSessionStarted → CameraSessionGate"]
  flag_state_in["IN: typed state<br/>TurretState / CameraStatus<br/>DistanceResult / config status"]
  flag_core_out["OUT: TRACKING selection / swap / click / mode<br/>StopMotion / motor / Emergency / config"]
  flag_config_in["IN: UiConfig snapshot"]

  subgraph ui["UI / PyQt6 main thread"]
    session_gate["CameraSessionGate<br/>accepted_generation + CameraModel"]

    subgraph main_window["Main Window"]
      main_view["Main Camera View<br/>Overview or Stereo Left"]
      preview_view["Preview View<br/>selection forbidden"]
      top_bar["Menu Bar<br/>recording / view / diagnostics / settings"]
      bottom_bar["Operational Bar<br/>mode / motor / link / Emergency<br/>fixed-size controls"]
      diagnostics["Diagnostics View<br/>Stereo Right separate"]
    end

    settings["Settings Window<br/>Vision / Aiming / Turret / UI"]
    selection["TRACKING target request<br/>camera + generation + track_id"]
    click_move["Click-to-move<br/>confirmed RELATIVE + main only"]
    turret_controls["Turret controls<br/>mode / motor / Emergency"]
    recording["Clean recording<br/>FramePacket.image without overlays"]
    state_view["Typed state<br/>camera freshness / Turret / distance"]
  end

  flag_session_in --> session_gate
  flag_vision_in --> session_gate
  session_gate --> main_view
  session_gate --> preview_view
  session_gate -.-> diagnostics
  session_gate -.-> recording
  flag_state_in --> state_view

  main_view --> selection
  main_view --> click_move
  selection --> flag_core_out
  click_move --> flag_core_out

  preview_view --> flag_core_out
  top_bar --> settings
  top_bar --> diagnostics
  top_bar --> recording
  bottom_bar --> turret_controls
  turret_controls --> flag_core_out
  settings --> flag_core_out
  flag_config_in -.-> settings
  state_view --> bottom_bar
