flowchart TB
  flag_motion_in["IN: motion intent<br/>MoveRelative or TrackingError"]
  flag_mode_in["IN: set_control_mode<br/>RELATIVE / TRACKING"]
  flag_control_in["IN: StopMotion / MOTOR_ON / MOTOR_OFF<br/>EMERGENCY_STOP"]
  flag_config_in["IN: Turret ConfigUpdate<br/>latest-only"]
  flag_core_out["OUT: TurretState"]

  stm32["STM32<br/>relative/velocity control<br/>acceleration limiter + watchdog"]

  subgraph turret["Turret"]
    pending_motion[["pending_motion latest-only<br/>MoveRelative | Velocity | None"]]
    pending_config[["latest pending<br/>STM32 config snapshot"]]
    control_ops["Control operation<br/>mode / Stop / motor / Emergency"]

    subgraph turret_thread["Turret worker"]
      controller["Turret Controller<br/>authoritative control_mode<br/>ownership boundaries"]
      pid["PID<br/>owned by Controller<br/>revision exactly once"]
      hal["Turret HAL<br/>units / invert / recovery"]
      arbiter["TX Arbiter<br/>one physical request in flight<br/>committed ordinary request"]
      serial["Serial Protocol<br/>one REQUEST_ID counter<br/>ID + COMMAND correlation"]
    end

    turret_state["TurretState<br/>control_mode / motor / connection"]
  end

  flag_motion_in --> controller
  controller -->|"RELATIVE intent"| pending_motion
  controller --> pid
  pid -->|"TRACKING velocity"| pending_motion
  pending_motion --> hal

  flag_mode_in --> control_ops --> controller
  flag_control_in --> control_ops
  controller -->|"zero handshake / mode apply"| hal
  hal --> arbiter

  flag_config_in --> pending_config --> hal

  arbiter --> serial
  serial <-->|"CONFIG / BAUD / MOVE / VELOCITY | EMERGENCY / MOTOR / PING"| stm32

  controller --> turret_state
  hal --> turret_state
  serial --> turret_state
  turret_state --> flag_core_out
