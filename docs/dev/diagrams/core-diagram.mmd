flowchart TB
  flag_vision_in["IN: CameraSessionStarted / VisionResult<br/>DistanceResult / CameraStatus"]
  flag_turret_out["OUT: MoveRelative / mode / motor<br/>TrackingError / StopMotion / EMERGENCY_STOP"]
  flag_turret_in["IN: TurretState"]
  flag_ui_in["IN: selection / swap / click / mode<br/>stop / motor / config"]
  flag_ui_out["OUT: main_camera / selected_target<br/>typed state / distance"]
  flag_config_out["OUT: ConfigUpdate<br/>в Vision / Turret / UI"]

  config_file[("config.json")]

  subgraph core["Core + shared main-thread state"]
    session_gate["CameraSessionGate<br/>accepted_generation + CameraModel"]
    mediator["Mediator<br/>main_camera / TRACKING selection<br/>coordination intents"]
    aiming["Aiming<br/>pixel_to_ray / lead<br/>camera Y → turret Y"]
    selected_target["selected_target<br/>None in RELATIVE<br/>TargetRef | None in TRACKING"]
    main_camera["main_camera<br/>Overview | Stereo Left"]
    system_state["Application state<br/>TurretState / camera / distance"]
    config_manager["Config Manager<br/>typed snapshots / revision"]
  end

  flag_vision_in -->|"session barrier"| session_gate
  flag_vision_in --> mediator
  flag_ui_in --> mediator
  flag_turret_in --> mediator

  session_gate --> mediator
  mediator --> selected_target
  mediator <--> main_camera
  selected_target --> aiming
  flag_vision_in --> aiming
  session_gate --> aiming
  aiming -->|"TrackingError / relative angle"| mediator

  mediator --> flag_turret_out
  mediator --> system_state
  flag_turret_in --> system_state
  system_state --> flag_ui_out
  selected_target --> flag_ui_out
  main_camera --> flag_ui_out

  config_file <-->|"atomic load / save"| config_manager
  mediator -->|"изменение настроек"| config_manager
  config_manager -.-> flag_config_out
  config_manager -.-> aiming
