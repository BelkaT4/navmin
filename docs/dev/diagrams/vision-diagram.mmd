flowchart TB
  overview_camera["Overview Camera"]
  left_camera["Stereo Left Camera"]
  right_camera["Stereo Right Camera"]
  calibration[("Calibration<br>overview.json / stereo.json")]
  flag_core_in["IN: main_camera / TRACKING selected_target<br>Vision ConfigUpdate"]
  flag_session_out["OUT: barrier<br>CameraSessionStarted<br>generation + CameraModel"]
  flag_ui_out["OUT: VisionResult working frames<br>generation checked by CameraSessionGate"]
  subgraph vision ["Vision"]
    pipeline_sessions["VisionPipeline per camera<br>start() owns generation<br>session_barriers / latest_result / status"]
    vision_config["VisionConfig<br>processing-scope / per-camera master<br>vision-processor-class"]
    right_buffer[["Bounded Stereo Right buffer<br>generation + capture_id"]]
    flag_data_out["OUT: latest<br>VisionResult / DistanceResult<br>CameraStatus"]
    subgraph overview_thread ["Overview pipeline"]
      overview_source["RTP/JPEG UDP / GStreamer decode<br>raw BGR latest-only"]
      overview_geom["Fisheye undistort<br>exact calibration size<br>working FramePacket"]
      overview_processor["VisionProcessor<br>effective processing policy"]
      overview_result["VisionResult<br>latest-only"]
    end
    subgraph left_thread ["Stereo Left pipeline"]
      left_source["RTP/JPEG UDP / GStreamer decode<br>raw BGR latest-only"]
      left_geom["Rectify Left<br>working FramePacket + capture_id"]
      left_processor["VisionProcessor<br>effective processing policy"]
      left_result["VisionResult<br>latest-only"]
      subgraph distance_provider ["Stereo / Distance Provider"]
        distance_switch["source: stereo / manual"]
        stereo_distance["Stereo Distance<br>selected_target only if Stereo Left"]
        manual_distance["Manual Distance"]
        distance_result["DistanceResult<br>latest / invalidatable"]
      end
    end
    subgraph right_thread ["Stereo Right pipeline"]
      right_source["RTP/JPEG UDP / GStreamer decode<br>raw BGR latest-only"]
      right_geom["Rectify Right<br>working FramePacket + capture_id"]
      right_processor["VisionProcessor optional<br>diagnostics"]
      right_result["VisionResult<br>diagnostics optional"]
    end
  end

  overview_source --> overview_geom
  overview_geom --> overview_processor
  overview_processor --> overview_result
  left_source --> left_geom
  left_geom --> left_processor
  left_processor --> left_result
  distance_switch --> stereo_distance
  distance_switch --> manual_distance
  stereo_distance --> distance_result
  manual_distance --> distance_result
  left_geom -.->|"left FramePacket"| stereo_distance
  left_result -.->|"selected TrackedObject"| stereo_distance
  right_source --> right_geom
  right_geom --> right_processor
  right_processor --> right_result
  right_geom --> right_buffer
  right_buffer -.->|"same generation pair + capture_id"| stereo_distance
  overview_camera --> overview_source
  left_camera --> left_source
  right_camera --> right_source
  calibration -.-> overview_geom
  calibration -.-> left_geom
  calibration -.-> right_geom
  pipeline_sessions -.-> overview_source
  pipeline_sessions -.-> left_source
  pipeline_sessions -.-> right_source
  pipeline_sessions -->|"CameraSessionStarted before data"| flag_session_out
  flag_core_in -.-> vision_config
  flag_core_in -->|"selected_target"| distance_switch
  vision_config -.-> overview_processor
  vision_config -.-> left_processor
  vision_config -.-> right_processor
  overview_result --> flag_data_out
  left_result --> flag_data_out
  distance_result --> flag_data_out
  overview_result --> flag_ui_out
  left_result --> flag_ui_out
  right_result -.->|"diagnostics"| flag_ui_out
